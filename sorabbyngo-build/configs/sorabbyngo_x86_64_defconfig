# Architecture
BR2_x86_64=y
BR2_x86_corei7=y

# Toolchain
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_KERNEL_HEADERS_6_6=y
BR2_TOOLCHAIN_GCC_AT_LEAST_12=y

# Kernel — use upstream 6.6 LTS for QEMU testing
# Switch to BR2_LINUX_KERNEL_CUSTOM_TARBALL for production
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_LATEST_VERSION=y
BR2_LINUX_KERNEL_USE_DEFCONFIG=y
BR2_LINUX_KERNEL_DEFCONFIG="x86_64"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y

# Init system — busybox init for lean ISO
# Switch to BR2_INIT_SYSTEMD for production
BR2_INIT_BUSYBOX=y

# System
BR2_TARGET_GENERIC_HOSTNAME="sorabbyngo"
BR2_TARGET_GENERIC_ISSUE="Sorabbyngo OS — Rhythm of Digital Life"
BR2_TARGET_GENERIC_ROOT_PASSWD="sorabbyngo"
BR2_TARGET_GENERIC_PASSWD_SHA256=y
BR2_ENABLE_LOCALE=y
BR2_GENERATE_LOCALE="en_US.UTF-8 sw_KE.UTF-8"
BR2_SYSTEM_DEFAULT_PATH="/bin:/sbin:/usr/bin:/usr/sbin"
BR2_ROOTFS_SKELETON_DEFAULT=y

# Shell
BR2_PACKAGE_BASH=y
BR2_PACKAGE_BASH_COMPLETION=y

# Python 3.12
BR2_PACKAGE_PYTHON3=y
BR2_PACKAGE_PYTHON3_PY_PYC=y
BR2_PACKAGE_PYTHON_PIP=y
BR2_PACKAGE_PYTHON3_SSL=y

# Essential packages
BR2_PACKAGE_BUSYBOX=y
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_UTIL_LINUX_MOUNT=y
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_OPENSSH=y
BR2_PACKAGE_WGET=y
BR2_PACKAGE_CA_CERTIFICATES=y
BR2_PACKAGE_DHCPCD=y
BR2_PACKAGE_IPROUTE2=y

# Filesystem tools
BR2_PACKAGE_DOSFSTOOLS=y
BR2_PACKAGE_PARTED=y

# Hardware support
BR2_PACKAGE_PCIUTILS=y
BR2_PACKAGE_USBUTILS=y

# Sorabbyngo rootfs overlay
BR2_ROOTFS_OVERLAY="board/sorabbyngo/overlay"

# Post build scripts
BR2_ROOTFS_POST_BUILD_SCRIPT="board/sorabbyngo/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="board/sorabbyngo/post-image.sh"

# Output formats
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="2G"
BR2_TARGET_ROOTFS_ISO9660=y
BR2_TARGET_ROOTFS_ISO9660_HYBRID=y

# GRUB2 bootloader
BR2_TARGET_GRUB2=y
BR2_TARGET_GRUB2_X86_64_EFI=y
BR2_TARGET_GRUB2_BUILTIN_MODULES_EFI="boot linux ext2 fat serial part_msdos part_gpt normal iso9660 gzio"
BR2_TARGET_GRUB2_BUILTIN_MODULES_PC="boot linux ext2 fat serial part_msdos part_gpt normal iso9660 gzio"
BR2_TARGET_GRUB2_BOOT_MENU="board/sorabbyngo/grub/grub.cfg"
